# Copy to .env (never commit .env).

# --- Secrets ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_NOTIFY=
# Optional: AI-written email pitches. Without it a template is used.
ANTHROPIC_API_KEY=

# --- Configuration ---
# Browser auto-submit is off unless this is 'true'
DIRECTORY_AUTOSUBMIT=false
SUBMIT_LIMIT=5
# Client name sent with search and page requests
CLIENT_ID=directory-prospector/1.0
